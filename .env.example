# Example only. Supply these to your process/service; Django does not auto-load this file.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=shop.example.com
# Set true ONLY behind a proxy you control that overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HTTPS=false
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@shop.example.com
